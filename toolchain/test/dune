(library
 (name pemu_toolchain_test)
 (libraries core pemu_toolchain pemu_spec_v1 pemu_monitor_v1 pemu_rtl_v1 pemu_protocols_v1)
 (inline_tests
  (deps
   (glob_files %{project_root}/toolchain/examples/*.s)))
 (preprocess
  (pps ppx_jane ppx_expect)))

; printed view of the ROM library, regenerated by the contract compiler on every build
(rule
 (targets printed_lib.ml)
 (action
  (with-stdout-to
   printed_lib.ml
   (run %{exe:../bin/pemu_cc.exe} print-library))))
